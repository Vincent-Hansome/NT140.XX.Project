<section class="page workspace-page" data-admin-products>
  <a class="member-back" href="/admin"><span aria-hidden="true">←</span> Quản trị cửa hàng</a>
  <div class="management-heading">
    <h1>Sản phẩm</h1>
    <button class="button button-dark" type="button" data-toggle-product-form aria-expanded="false" aria-controls="admin-product-form"><span aria-hidden="true">＋</span> Thêm sản phẩm</button>
  </div>
  <form class="admin-product-form" id="admin-product-form" data-product-form hidden enctype="multipart/form-data">
    <label>Tên sản phẩm<input name="name" required maxlength="255" autocomplete="off"></label>
    <label>Mô tả<textarea name="description" rows="4" maxlength="10000"></textarea></label>
    <div class="admin-form-grid">
      <label>Giá (₫)<input name="price" type="number" min="0" max="99999999.99" step="0.01" required></label>
      <label>Số lượng tồn kho<input name="stock" type="number" min="0" step="1" value="0" required></label>
      <label>Kích thước<input name="size" maxlength="50" placeholder="Ví dụ: S / M / L"></label>
      <label>Màu sắc<input name="color" maxlength="50" placeholder="Ví dụ: Xanh rêu"></label>
      <label>Danh mục<select name="category_id" data-category-select><option value="">Không phân loại</option></select></label>
      <label>Ảnh sản phẩm<input name="image" type="file" accept="image/jpeg,image/png,image/webp"><small>JPG, PNG hoặc WebP · tối đa 5 MB</small></label>
    </div>
    <div class="admin-form-actions"><button class="button button-dark" type="submit">Lưu sản phẩm →</button><button class="button button-outline" type="button" data-cancel-product-form>Hủy</button></div>
  </form>
  <div class="form-message" data-admin-message aria-live="polite"></div>
  <div class="admin-product-list" data-admin-product-list><p class="loading">Đang tải sản phẩm…</p></div>
  <dialog class="variant-dialog" data-variant-dialog aria-labelledby="variant-heading">
    <form data-variant-form>
      <h2 id="variant-heading">Biến thể</h2>
      <p data-variant-name></p>
      <div data-variant-rows></div>
      <button type="button" class="button button-outline" data-variant-new>Thêm cỡ và màu</button>
      <p class="form-message" data-variant-status role="status"></p>
      <div class="member-form-actions">
        <button type="submit" class="button button-dark">Lưu tồn kho</button>
        <button type="button" class="button button-outline" data-variant-cancel>Đóng</button>
      </div>
    </form>
  </dialog>
  <script src="/js/variant-admin.js" defer></script>
</section>
