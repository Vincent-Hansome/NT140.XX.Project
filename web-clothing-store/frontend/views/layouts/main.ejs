<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#faf8f2">
  <meta name="description" content="Khám phá bộ sưu tập quần áo và phụ kiện của MỘC.">
  <meta name="moc-api" content="<%= apiUrl %>">
  <title><%= pageTitle %> — MỘC</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/shell.css">
  <% const engagementPage = currentPath === '/' || currentPath.startsWith('/products') || currentPath === '/wishlist'; %>
  <% const commercePage = ['/checkout','/orders','/admin/orders'].includes(currentPath); %>
  <% if (engagementPage) { %><link rel="stylesheet" href="/css/engagement.css"><% } %>
  <% if (commercePage) { %><link rel="stylesheet" href="/css/commerce.css"><% } %>
  <% if (['/notifications','/admin/reports'].includes(currentPath)) { %><link rel="stylesheet" href="/css/insights.css"><% } %>
  <% if (currentPath === '/' || currentPath.startsWith('/products') || ['/cart', '/checkout'].includes(currentPath)) { %>
    <link rel="stylesheet" href="/css/shop.css">
  <% } else { %>
    <% if (currentPath.endsWith('/support')) { %><link rel="stylesheet" href="/css/support.css"><% } %>
    <link rel="stylesheet" href="/css/account.css">
  <% } %>
</head>
<body>
  <%- include('../partials/header') %>
  <main id="main-content" tabindex="-1"><%- body %></main>
  <%- include('../partials/footer') %>
  <script src="/js/api.js" defer></script>
  <% if (commercePage) { %><script src="/js/commerce.js" defer></script><% } %>
  <script src="/js/store.js" defer></script>
  <% if (engagementPage) { %><script src="/js/engagement.js" defer></script><% } %>
  <% if (['/profile','/notifications','/admin/reports'].includes(currentPath)) { %><script src="/js/insights.js" defer></script><% } %>
  <% if (currentPath.endsWith('/support')) { %><script src="/js/support.js" defer></script><% } %>
</body>
</html>
