<% if (page === 'home') { %>
  <section class="shop-hero" aria-labelledby="hero-title">
    <div class="shop-hero-copy">
      <p class="shop-kicker">Bộ sưu tập MỘC</p>
      <h1 id="hero-title">Tủ đồ<br><em>thường nhật.</em></h1>
      <p class="shop-lead">Từ áo sơ mi đến những lớp áo khoác, chọn món đồ hợp với nhịp sống của bạn.</p>
      <a class="shop-cta" href="/products">Khám phá bộ sưu tập <span aria-hidden="true">→</span></a>
    </div>
    <!-- Mert Coşkun, Pexels 33401720 -->
    <img class="shop-hero-photo" src="/images/editorial/collection.jpg" alt="Người mẫu mặc blazer xám dáng rộng trước bức tường màu cát" width="1500" height="1000" fetchpriority="high">
  </section>
<% } %>
<section class="shop-wrap shop-catalog" id="collection">
  <% if (page !== 'home') { %>
    <nav class="shop-crumbs" aria-label="Đường dẫn"><a href="/">Trang chủ</a><span aria-hidden="true">/</span><span aria-current="page">Bộ sưu tập</span></nav>
  <% } %>
  <div class="shop-section-heading">
    <% if (page === 'home') { %>
      <h2>Sản phẩm nổi bật</h2>
      <a class="shop-link" href="/products">Xem tất cả <span aria-hidden="true">↗</span></a>
    <% } else { %>
      <h1>Bộ sưu tập</h1>
      <span class="shop-count" data-product-count aria-live="polite"></span>
    <% } %>
  </div>
  <% if (page !== 'home') { %>
    <nav class="shop-filters" data-category-filters aria-label="Lọc theo danh mục" hidden></nav>
    <form class="catalog-search" data-catalog-search role="search" aria-label="Tìm và lọc sản phẩm">
      <label>Tên sản phẩm<input type="search" name="query" placeholder="Tìm sản phẩm"></label>
      <label>Giá từ (₫)<input type="number" name="minPrice" min="0" step="any" placeholder="0"></label>
      <label>Giá đến (₫)<input type="number" name="maxPrice" min="0" step="any"></label>
      <label>Kích cỡ<select name="size"><option value="">Tất cả</option></select></label>
      <label>Màu sắc<select name="color"><option value="">Tất cả</option></select></label>
      <label class="catalog-stock"><input name="inStock" type="checkbox"> Còn hàng</label>
      <button class="shop-link" type="reset">Xóa bộ lọc</button>
    </form>
  <% } %>
  <div class="shop-grid" id="product-grid" data-products <% if (page === 'home') { %>data-limit="4"<% } %>>
    <p class="shop-status" role="status">Đang tải sản phẩm…</p>
  </div>
</section>
<% if (page === 'home') { %>
  <section class="shop-story" id="story" aria-labelledby="story-title">
    <!-- Teona Swift, Pexels 6850497 -->
    <img src="/images/editorial/linen.jpg" loading="lazy" alt="Những lớp vải lanh xếp chồng trong ánh nắng">
    <div>
      <p class="shop-kicker">Câu chuyện MỘC</p>
      <h2 id="story-title">Bắt đầu từ<br><em>chất liệu.</em></h2>
      <p>MỘC yêu những điều giản dị trong tủ đồ mỗi ngày. Một nếp gấp trên vải, một đường may vừa vặn, một món đồ bạn vẫn muốn mặc lại.</p>
      <a class="shop-link" href="/products">Khám phá sản phẩm <span aria-hidden="true">↗</span></a>
    </div>
  </section>
<% } %>
