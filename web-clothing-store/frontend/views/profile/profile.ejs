<section class="page member-page" data-profile-page>
  <h1>Tài khoản của bạn</h1>
  <p class="profile-loading" role="status">Đang tải thông tin…</p>
  <p class="form-message" data-profile-message role="status"></p>
  <div class="profile-content member-columns" hidden>
    <section class="member-identity" aria-labelledby="member-info-title">
      <h2 id="member-info-title">Thông tin cá nhân</h2>
      <dl class="member-data">
        <div><dt>Họ và tên</dt><dd data-profile-name></dd></div>
        <div><dt>Email</dt><dd data-profile-email></dd></div>
        <div><dt>Thành viên từ</dt><dd data-profile-created></dd></div>
      </dl>
      <button class="button button-outline" type="button" data-password-toggle aria-expanded="false" aria-controls="member-password">Đổi mật khẩu</button>
      <form class="profile-password-form" id="member-password" data-password-change-form hidden aria-labelledby="password-title">
        <h3 id="password-title">Đổi mật khẩu</h3>
        <label>Mật khẩu hiện tại
          <input name="currentPassword" type="password" required maxlength="1024" autocomplete="current-password">
        </label>
        <label>Mật khẩu mới
          <input name="newPassword" type="password" required minlength="12" maxlength="72" autocomplete="new-password" aria-describedby="password-hint">
        </label>
        <small id="password-hint">Ít nhất 12 ký tự, tối đa 72 byte UTF-8. Sau khi đổi, bạn cần đăng nhập lại.</small>
        <p class="form-message" data-password-message role="status"></p>
        <div class="member-form-actions">
          <button class="button button-dark" type="submit">Lưu mật khẩu mới</button>
          <button class="button button-outline" type="button" data-password-cancel>Hủy</button>
        </div>
      </form>
    </section>
    <aside class="member-links" aria-label="Lối tắt tài khoản">
      <a href="/orders">Đơn hàng của tôi <span aria-hidden="true">↗</span></a>
      <a href="/wishlist">Sản phẩm yêu thích <span aria-hidden="true">↗</span></a>
      <a href="/notifications">Thông báo <span data-notification-count></span></a>
      <a href="/support">Yêu cầu hỗ trợ <span aria-hidden="true">↗</span></a>
      <button class="member-logout" type="button" data-logout>Đăng xuất</button>
    </aside>
  </div>
</section>
